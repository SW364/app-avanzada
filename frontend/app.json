{
  "expo": {
    "name": "CalcuVerbs Advanced",
    "slug": "calcuverbs-advanced",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calcuverbs-advanced",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calcuverbs.advanced",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Di tus respuestas en voz alta para practicar",
        "NSSpeechRecognitionUsageDescription": "Revisa tu pronunciaci\u00f3n mientras practicas"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.calcuverbs.advanced",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Di tus respuestas en voz alta para practicar",
          "speechRecognitionPermission": "Revisa tu pronunciaci\u00f3n mientras practicas",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.samsung.android.bixby.agent"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "64fb4207-d6db-400d-aa97-02e837b36e45"
      },
      "backendUrl": "https://calcuverbs-pasiva.preview.emergentagent.com"
    },
    "owner": "sw3644"
  }
}
